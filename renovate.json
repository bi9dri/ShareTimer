{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "automergeType": "pr",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Group Node runtime and @types/node updates together",
      "matchPackageNames": ["node", "@types/node"],
      "groupName": "node"
    },
    {
      "description": "Group pnpm updates across .mise.toml and package.json",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Group Playwright package and CI container image updates together",
      "matchPackageNames": ["@playwright/test", "playwright", "playwright-core", "mcr.microsoft.com/playwright"],
      "groupName": "playwright"
    }
  ]
}
