{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "automerge": true,
  "automergeType": "pr",
  "timezone": "Asia/Tokyo",
  "schedule": ["before 6am on monday"],
  "rebaseWhen": "conflicted",
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": null,
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Group non-major npm dependencies together",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Group GitHub Actions updates together",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Group Node runtime and @types/node updates together",
      "matchPackageNames": ["node", "@types/node"],
      "groupName": "node"
    },
    {
      "description": "Group pnpm updates across .mise.toml and package.json",
      "matchPackageNames": ["pnpm"],
      "groupName": "pnpm"
    },
    {
      "description": "Group Playwright package updates together",
      "matchPackageNames": ["@playwright/test", "playwright", "playwright-core"],
      "groupName": "playwright"
    },
    {
      "description": "Group vite-plus and @voidzero-dev/vite-plus-core updates together across major/minor",
      "matchPackageNames": ["vite-plus", "@voidzero-dev/vite-plus-core"],
      "groupName": "vite+",
      "separateMajorMinor": false
    }
  ]
}
